<?xml version="1.0"?>
<addon scheme="3.0">
    <id>fgo_invoicing</id>
    <version>0.1.0</version>
    <priority>120</priority>
    <position>10</position>
    <status>active</status>
    <has_icon>N</has_icon>
    <supplier>VacanteLitoral.ro</supplier>
    <supplier_link>https://vacantelitoral.ro</supplier_link>
    <default_language>en</default_language>
    <!-- FGO Invoicing: Romanian e-invoicing via api.fgo.ro. Requires PHP 8.3+.

         NOTE ON <name> ELEMENTS BELOW:
         CS-Cart's XmlScheme3::_getSettingItem() resolves a setting's label as
             isset($po['SettingsOptions::fgo_invoicing::<id>'])
                 ? <that .po value>
                 : (string) $xml_node->name
         and _getVariants() does the same with (string) $variant->name.
         If var/langs/<lang>/addons/fgo_invoicing.po is missing or unreadable on
         the target shop, the .po branch misses and the label becomes an EMPTY
         STRING — the whole settings form renders with blank labels.
         The <name> children below are that hard fallback, so labels always
         render even with no language pack deployed. The .po still wins when
         present and is what supplies non-English translations. -->

    <authors>
        <author>
            <name>VacanteLitoral.ro</name>
            <email>office@VacanteLitoral.ro</email>
            <url>https://vacantelitoral.ro</url>
        </author>
    </authors>

    <compatibility>
        <core_version>
            <min>4.9.3</min>
            <max>4.20.1</max>
        </core_version>
        <core_edition>ULTIMATE</core_edition>
        <php_version>
            <min>8.3.0</min>
            <max>8.4.99</max>
        </php_version>
        <php_extensions>
            <curl>
                <supported>Y</supported>
            </curl>
            <json>
                <supported>Y</supported>
            </json>
        </php_extensions>
    </compatibility>

    <settings layout="separate">
        <sections>
            <section id="general">
                <name>General Settings</name>
                <items>
                    <!-- API credentials -->
                    <item id="credentials_header">
                        <name>API Credentials</name>
                        <type>header</type>
                        <variants/>
                    </item>
                    <item id="client_code">
                        <name>Client code (CodUnic / CIF)</name>
                        <type>input</type>
                        <default_value></default_value>
                        <variants/>
                    </item>
                    <item id="private_key">
                        <name>FGO private API key</name>
                        <type>password</type>
                        <default_value></default_value>
                        <variants/>
                    </item>
                    <item id="sandbox">
                        <name>Use sandbox (api-testuat.fgo.ro)</name>
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                        <variants/>
                    </item>

                    <!-- Trigger / Behaviour -->
                    <item id="behaviour_header">
                        <name>Trigger &amp; Behaviour</name>
                        <type>header</type>
                        <variants/>
                    </item>
                    <item id="api_call">
                        <name>Issue invoice on</name>
                        <type>selectbox</type>
                        <default_value>onPayment</default_value>
                        <variants>
                            <item id="onOrder"><name>Place order</name></item>
                            <item id="onPayment"><name>Payment confirmed</name></item>
                            <item id="onCompleted"><name>Order completed</name></item>
                            <item id="manual"><name>Manual only</name></item>
                        </variants>
                    </item>
                    <item id="invoice_type">
                        <name>Document type</name>
                        <type>selectbox</type>
                        <default_value>Factura</default_value>
                        <variants>
                            <item id="Factura"><name>Factura (invoice)</name></item>
                            <item id="Proforma"><name>Proforma</name></item>
                            <item id="Aviz"><name>Aviz (delivery note)</name></item>
                            <item id="T"><name>Special document type T</name></item>
                            <item id="S"><name>Special document type S</name></item>
                            <item id="U"><name>Special document type U</name></item>
                            <item id="H"><name>Special document type H</name></item>
                            <item id="n"><name>Special document type n</name></item>
                            <item id="X"><name>Special document type X</name></item>
                            <item id="M"><name>Special document type M</name></item>
                            <item id="Y"><name>Special document type Y</name></item>
                            <item id="D"><name>Special document type D</name></item>
                            <item id="d"><name>Special document type d</name></item>
                            <item id="L"><name>Special document type L</name></item>
                        </variants>
                    </item>
                    <item id="invoice_series">
                        <name>Invoice series</name>
                        <type>input</type>
                        <default_value></default_value>
                        <variants/>
                    </item>
                    <item id="verify_duplicate">
                        <name>Ask FGO to deduplicate (VerificareDuplicat)</name>
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                        <variants/>
                    </item>
                    <item id="auto_email_pdf">
                        <name>Email the PDF link to the customer after issuance</name>
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                        <variants/>
                    </item>
                    <item id="min_call_interval_ms">
                        <name>Minimum interval between FGO calls (ms)</name>
                        <type>input</type>
                        <default_value>1000</default_value>
                        <variants/>
                    </item>

                    <!-- Customer / VAT -->
                    <item id="customer_header">
                        <name>Customer / VAT</name>
                        <type>header</type>
                        <variants/>
                    </item>
                    <item id="sanitize_vat">
                        <name>Validate Romanian CIF (ValideazaCodUnicRo)</name>
                        <type>checkbox</type>
                        <default_value>N</default_value>
                        <variants/>
                    </item>
                    <item id="client_vat_required">
                        <name>Do not issue for company customers without a CIF</name>
                        <type>checkbox</type>
                        <default_value>N</default_value>
                        <variants/>
                    </item>
                    <item id="client_cnp_required">
                        <name>Do not issue for individuals without a CNP</name>
                        <type>checkbox</type>
                        <default_value>N</default_value>
                        <variants/>
                    </item>
                    <!-- Which custom profile field (Administration > Profile fields)
                         holds each identifier. Options come from
                         fn_settings_variants_addons_fgo_invoicing_<id>()
                         (functions/settings_variants.php), hence the empty
                         <variants/>. The default '' is "Auto-detect by field
                         name", which is also how a store without these rows
                         behaves (ConfigProvider). Keep them at the END of this
                         header: SettingsPlacement moves healed rows back here. -->
                    <item id="cif_field">
                        <name>Profile field holding the CIF (company tax ID)</name>
                        <type>selectbox</type>
                        <default_value></default_value>
                        <variants/>
                    </item>
                    <item id="reg_com_field">
                        <name>Profile field holding the Reg. Com. number</name>
                        <type>selectbox</type>
                        <default_value></default_value>
                        <variants/>
                    </item>
                    <item id="cnp_field">
                        <name>Profile field holding the CNP (individuals)</name>
                        <type>selectbox</type>
                        <default_value></default_value>
                        <variants/>
                    </item>

                    <!-- Lines / Codes -->
                    <item id="lines_header">
                        <name>Invoice Lines &amp; Codes</name>
                        <type>header</type>
                        <variants/>
                    </item>
                    <item id="article_id_field">
                        <name>Article identifier (CodArticol)</name>
                        <type>selectbox</type>
                        <default_value>sku</default_value>
                        <variants>
                            <item id="none"><name>None</name></item>
                            <item id="sku"><name>SKU (product code)</name></item>
                            <item id="ean13"><name>EAN-13</name></item>
                            <item id="isbn"><name>ISBN</name></item>
                            <item id="upc"><name>UPC</name></item>
                        </variants>
                    </item>
                    <item id="product_description">
                        <name>Append SKU to line description</name>
                        <type>checkbox</type>
                        <default_value>N</default_value>
                        <variants/>
                    </item>
                    <item id="additional_info">
                        <name>Add CS-Cart order number to invoice notes</name>
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                        <variants/>
                    </item>
                    <item id="shipping_tax_vat">
                        <name>Shipping VAT handling</name>
                        <type>selectbox</type>
                        <default_value>vat_not_included</default_value>
                        <variants>
                            <item id="vat_included"><name>Tax-inclusive (PretTotal)</name></item>
                            <item id="vat_not_included"><name>Net unit price (PretUnitar)</name></item>
                            <item id="vat_zero"><name>Zero VAT</name></item>
                        </variants>
                    </item>
                    <item id="shipping_code">
                        <name>Shipping article code</name>
                        <type>input</type>
                        <default_value>SHIPPING</default_value>
                        <variants/>
                    </item>
                    <item id="discount_code">
                        <name>Discount article code</name>
                        <type>input</type>
                        <default_value>DISCOUNT</default_value>
                        <variants/>
                    </item>
                    <item id="administration_code">
                        <name>Warehouse code (CodGestiune)</name>
                        <type>input</type>
                        <default_value></default_value>
                        <variants/>
                    </item>

                    <!-- Resilience / Diagnostics -->
                    <item id="resilience_header">
                        <name>Resilience &amp; Diagnostics</name>
                        <type>header</type>
                        <variants/>
                    </item>
                    <item id="api_max_retries">
                        <name>HTTP retry attempts</name>
                        <type>input</type>
                        <default_value>2</default_value>
                        <variants/>
                    </item>
                    <item id="api_retry_delay_ms">
                        <name>Initial retry delay (ms)</name>
                        <type>input</type>
                        <default_value>500</default_value>
                        <variants/>
                    </item>
                    <item id="api_cb_threshold">
                        <name>Circuit breaker open threshold</name>
                        <type>input</type>
                        <default_value>5</default_value>
                        <variants/>
                    </item>
                    <item id="api_cb_timeout">
                        <name>Circuit breaker open timeout (s)</name>
                        <type>input</type>
                        <default_value>60</default_value>
                        <variants/>
                    </item>
                    <item id="debug_logging">
                        <name>Debug logging</name>
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                        <variants/>
                    </item>
                </items>
            </section>
        </sections>
    </settings>

    <queries>
        <item for="install">
            CREATE TABLE IF NOT EXISTS `?:fgo_invoices` (
                `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
                `order_id` int(11) unsigned NOT NULL,
                `cart_id` int(11) unsigned DEFAULT NULL,
                `request_payload` LONGTEXT NULL COMMENT 'JSON-encoded form fields sent to FGO',
                `payload` LONGTEXT NULL COMMENT 'Raw JSON response from FGO',
                `success` TINYINT(1) NULL,
                `message` VARCHAR(255) NULL,
                `invoice_number` VARCHAR(64) NULL COMMENT 'Factura.Numar',
                `invoice_series` VARCHAR(32) NULL COMMENT 'Factura.Serie',
                `pdf_link` VARCHAR(2048) NULL COMMENT 'Factura.Link signed PDF URL',
                `payment_link` VARCHAR(2048) NULL COMMENT 'Factura.LinkPlata',
                `awb` VARCHAR(64) NULL,
                `status` ENUM('pending','issued','failed','canceled','reversed','deleted') NOT NULL DEFAULT 'pending',
                `last_error` TEXT NULL,
                `retry_count` INT NOT NULL DEFAULT 0,
                `created_at` datetime DEFAULT CURRENT_TIMESTAMP,
                `updated_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
                PRIMARY KEY (`id`),
                UNIQUE KEY `idx_order_id` (`order_id`),
                KEY `idx_status` (`status`),
                KEY `idx_invoice_number` (`invoice_number`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='FGO issued invoices, one row per CS-Cart order'
        </item>
        <item for="uninstall">DROP TABLE IF EXISTS `?:fgo_invoices`</item>
        <item for="uninstall">DELETE FROM ?:language_values WHERE name LIKE 'fgo_invoicing.%'</item>
    </queries>

