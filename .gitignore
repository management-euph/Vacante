# Auto-generated theme presets (created by addon install, cleaned on uninstall)
design/themes/*/styles/data/novoton_default/

# Environment & Secrets
.env
.env.local
.env.*.local
.env.production

# Logs
*.log
logs/
var/logs/

# CS-Cart System
var/cache/
var/compiled/
var/sticky/
var/tmp/

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code worktrees (temporary agent sandboxes)
.claude/

# Package Managers
vendor/
node_modules/

# QA tool caches and reports (PHPStan, Psalm, PHP CS Fixer, PHPUnit)
var/
# ...but an addon's language packs (var/langs/*/addons/*.po) are deployable
# source: without this, a new addon's .po files are silently left out (the
# Netopia packs were never committed and the addon had no name in the admin).
!/addon-*/var/
/addon-*/var/*
!/addon-*/var/langs/
phpcs.cache
.phpunit.result.cache
.phpunit.cache/
.phpunit.cache.integration/
.php-cs-fixer.cache

# PHPStan baseline-paydown working configs (derived from phpstan.neon; not committed)
/phpstan-nobaseline.neon
/phpstan-agent*.neon
/phpstan-*tmp*.neon

# Legacy pre-split monolithic addon (archived — use addon-* directories instead)
NovotonBeforeSplit/

# OS Files
.DS_Store
Thumbs.db
addon-*.zip
dist/

# HP Sure Click (Bromium) isolation markers on Windows checkouts: unreadable
# inside Docker, they crash CS-Cart's template scan. Never commit them.
~BROMIUM/
~BROMIUM

# NETOPIA key files uploaded in the dev store's admin: the store's addon dir
# is a symlink into this checkout, so KeyStorage writes them here. Private
# keys must never reach the repo.
addon-netopia-payments-main/app/addons/netopia_payments/keys/

# Browser network captures (HAR) carry session cookies and request bodies.
# Never commit them; scrub and share them out of band when needed.
*.har
*_Archive*.har
devx.autoakt.ro_Archive*
