            "text": "<!DOCTYPE html>\n<html \n lang=\"en\" dir=\"ltr\" class=\"dialog-mobile-bottom\">\n<head>\n<title>Your order has been received</title>\n<base href=\"https://devx.autoakt.ro/\" />\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" data-ca-mode=\"\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<meta name=\"description\" content=\"\" />\n\n<meta name=\"keywords\" content=\"\" />\n<meta name=\"format-detection\" content=\"telephone=no\">\n\n            \n    <link title=\"English\" dir=\"ltr\" type=\"text/html\" rel=\"alternate\" hreflang=\"x-default\" href=\"https://devx.autoakt.ro/index.php?dispatch=checkout.complete&amp;order_id=37\" />\n    <link title=\"English\" dir=\"ltr\" type=\"text/html\" rel=\"alternate\" hreflang=\"en\" href=\"https://devx.autoakt.ro/index.php?dispatch=checkout.complete&amp;order_id=37\" />\n    <link title=\"Română\" dir=\"ltr\" type=\"text/html\" rel=\"alternate\" hreflang=\"ro\" href=\"https://devx.autoakt.ro/index.php?dispatch=checkout.complete&amp;order_id=37&amp;sl=ro\" />\n\n\n    <link href=\"https://devx.autoakt.ro/images/logos/1/favicon_pc7g-kt.ico\" rel=\"shortcut icon\" type=\"image/png\" />\n\n<link rel=\"preload\" crossorigin=\"anonymous\" as=\"font\" href=\"https://devx.autoakt.ro/design/themes/nova_theme/media/fonts/inter_regular.woff2?1776786588\" type=\"font/woff2\" />\n<link type=\"text/css\" rel=\"stylesheet\" href=\"https://devx.autoakt.ro/var/cache/misc/assets/design/themes/nova_theme/css/standalone.6e59ec94f88ffdff524f76bd402e463d1776786585.css?1776786585\" /><script data-no-defer>\nwindow.jsErrors = [];\nwindow.onerror = function(message, source, lineno, colno, error) {\n    var verboseMessage = message;\n    if (source) {\n        verboseMessage = source + '@' + lineno + ':' + colno + \"\\n\\n\" + message;\n    }\n\n    console.error(verboseMessage);\n\n    if (error && error.stack) {\n        console.log(error.stack);\n    }\n\n    document.write('<pre data-ca-debug=\"1\" style=\"border: 2px solid red; margin: 2px;\">'\n        + verboseMessage + \"\\n\\n\"\n        + (error && error.stack ? error.stack : '')\n        + '</pre>'\n    );\n};\n</script>\n<!--[if lt IE 9]><script src=\"https://cdnjs.cloudflare.com/ajax/libs/es5-shim/4.1.9/es5-shim.min.js\"></script><![endif]-->\n\n    <script \n        data-no-defer\n        type=\"text/javascript\"\n        src=\"https://devx.autoakt.ro/var/files/gdpr/klaro/config.js\">\n    </script>\n    <script \n        data-no-defer\n        data-klaro-config=\"klaroConfig\"\n        data-config=\"klaroConfig\"\n        type=\"text/javascript\"\n        src=\"https://devx.autoakt.ro/js/addons/gdpr/lib/klaro.js\">\n    </script>\n</head>\n\n<body>\n    <div id=\"tygh_settings\" class=\"hidden\" data-ca-current-location=\"https://devx.autoakt.ro\" data-ca-area=\"C\" ></div>\n            \n        <div class=\"ty-tygh  \" data-ca-element=\"mainContainer\" id=\"tygh_container\">\n\n        <div id=\"ajax_overlay\" class=\"ty-ajax-overlay\"></div>\n<div id=\"ajax_loading_box\" class=\"ty-ajax-loading-box\"></div>\n        <div class=\"cm-notification-container notification-container\">\n    <div class=\"cm-notification-content notification-content cm-auto-hide alert-success\" data-ca-notification-key=\"d4c50bec0eb4e6b606fdc197ac74ebde\">\n        <button type=\"button\" class=\"close cm-notification-close \" data-dismiss=\"alert\">&times;</button>\n        <strong>Order placed</strong>\n        Congratulations! Your order has been successfully placed.\n    </div>\n</div>\n        <div class=\"ty-helper-container \"\n                    id=\"tygh_main_container\">\n                                             \n<div class=\"tygh-top-panel clearfix\">\n                <div class=\"container-fluid  ty-cs-controller-checkout ty-cs-mode-complete  top-grid ty-top-panel-grid-responsive\">\n                                                \n            <div class=\"row-fluid\"> 