eld--input\\\"\\n    data-ca-error-message-target-method=\\\"append\\\" >\\n            <input class=\\\"litecheckout__input shipping-address\\\"\\n               placeholder=\\\" \\\"\\n               id=\\\"litecheckout_s_address\\\"\\n               type=\\\"text\\\"\\n               name=\\\"user_data[s_address]\\\"\\n               value=\\\"\\\"\\n               data-ca-lite-checkout-field=\\\"user_data.s_address\\\"\\n               data-ca-lite-checkout-auto-save=\\\"true\\\"\\n               autocomplete=\\\"\\\"\\n               aria-label=\\\"Address\\\"\\n               required data-ca-custom-validation\\n        \\/>\\n                <label class=\\\"litecheckout__label  cm-required cm-trim\\\" for=\\\"litecheckout_s_address\\\">Address<\\/label>\\n    <\\/div>                                    \\n        \\n                            \\n                \\n                                                    \\n                                                    \\n        \\n                                                \\n        \\n        \\n                \\n                    <div class=\\\"litecheckout__field cm-field-container litecheckout__field--small litecheckout__field--input\\\"\\n    data-ca-error-message-target-method=\\\"append\\\" >\\n            <input class=\\\"litecheckout__input shipping-city\\\"\\n               placeholder=\\\" \\\"\\n               id=\\\"litecheckout_s_city\\\"\\n               type=\\\"text\\\"\\n               name=\\\"user_data[s_city]\\\"\\n               value=\\\"Boston\\\"\\n               data-ca-lite-checkout-field=\\\"user_data.s_city\\\"\\n               data-ca-lite-checkout-auto-save=\\\"true\\\"\\n               autocomplete=\\\"\\\"\\n               aria-label=\\\"City\\\"\\n               required data-ca-custom-validation\\n        \\/>\\n                <label class=\\\"litecheckout__label  cm-required cm-trim\\\" for=\\\"litecheckout_s_city\\\">City<\\/label>\\n    <\\/div>             