0442\\u0430 \\u0435 \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u044a\\u043f\\u043d\\u0430\",\"serviceUnavailableText\":\"\\u0423\\u0441\\u043b\\u0443\\u0433\\u0430\\u0442\\u0430 \\u0435 \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u044a\\u043f\\u043d\\u0430 \\u043f\\u043e\\u0440\\u0430\\u0434\\u0438 \\u043f\\u043b\\u0430\\u043d\\u0438\\u0440\\u0430\\u043d\\u0430 \\u043f\\u043e\\u0434\\u0434\\u0440\\u044a\\u0436\\u043a\\u0430. \\u0420\\u0430\\u0431\\u043e\\u0442\\u0438\\u043c \\u043c\\u0435\\u0436\\u0434\\u0443 {{timeStart}} \\u0438 {{timeEnd}} \\u0447\\u0430\\u0441\\u0430, \\u0437\\u0430 \\u0434\\u0430 \\u043f\\u043e\\u0434\\u043e\\u0431\\u0440\\u0438\\u043c \\u0432\\u0430\\u0448\\u0435\\u0442\\u043e \\u043f\\u0440\\u0435\\u0436\\u0438\\u0432\\u044f\\u0432\\u0430\\u043d\\u0435 \\u0438 \\u0434\\u0430 \\u0433\\u0430\\u0440\\u0430\\u043d\\u0442\\u0438\\u0440\\u0430\\u043c\\u0435, \\u0447\\u0435 \\u0432\\u0441\\u0438\\u0447\\u043a\\u043e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0438 \\u043f\\u0435\\u0440\\u0444\\u0435\\u043a\\u0442\\u043d\\u043e.\",\"serviceUnavailableHint\":\"\\u0411\\u043b\\u0430\\u0433\\u043e\\u0434\\u0430\\u0440\\u0438\\u043c \\u0432\\u0438 \\u0437\\u0430 \\u0442\\u044a\\u0440\\u043f\\u0435\\u043d\\u0438\\u0435\\u0442\\u043e \\u0438 \\u0440\\u0430\\u0437\\u0431\\u0438\\u0440\\u0430\\u043d\\u0435\\u0442\\u043e.\",\"validation_errors\":{\"card\":{\"startWith\":\"\\u041d\\u043e\\u043c\\u0435\\u0440\\u044a\\u0442 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0442\\u0440\\u044f\\u0431\\u0432\\u0430 \\u0434\\u0430 \\u0437\\u0430\\u043f\\u043e\\u0447\\u0432\\u0430 \\u0441 2, 4, 5, 6 \\u0438\\u043b\\u0438 9\",\"maxDigits\":\"\\u041d\\u043e\\u043c\\u0435\\u0440\\u044a\\u0442 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0442\\u0440\\u044f\\u0431\\u0432\\u0430 \\u0434\\u0430 \\u0431\\u044a\\u0434\\u0435 16 \\u0438\\u043b\\u0438 18 \\u0446\\u0438\\u0444\\u0440\\u0438\",\"onlyDigits\":\"\\u041d\\u043e\\u043c\\u0435\\u0440\\u044a\\u0442 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0442\\u0440\\u044f\\u0431\\u0432\\u0430 \\u0434\\u0430 \\u0441\\u044a\\u0434\\u044a\\u0440\\u0436\\u0430 \\u0441\\u0430\\u043c\\u043e \\u0446\\u0438\\u0444\\u0440\\u0438\",\"invalid\":\"\\u041d\\u043e\\u043c\\u0435\\u0440\\u044a\\u0442 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0435 \\u043d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u0435\\u043d\"},\"date\":{\"invalid\":\"\\u041d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430 \\u0434\\u0430\\u0442\\u0430\",\"inTheFuture\":\"\\u041c\\u043e\\u043b\\u044f, \\u0432\\u044a\\u0432\\u0435\\u0434\\u0435\\u0442\\u0435 \\u0434\\u0430\\u0442\\u0430 \\u0432 \\u0431\\u044a\\u0434\\u0435\\u0449\\u0435\\u0442\\u043e\"},\"cvv\":{\"onlyDigits\":\"CVV \\u043a\\u043e\\u0434\\u044a\\u0442 \\u0442\\u0440\\u044f\\u0431\\u0432\\u0430 \\u0434\\u0430 \\u0441\\u044a\\u0434\\u044a\\u0440\\u0436\\u0430 \\u0441\\u0430\\u043c\\u043e \\u0446\\u0438\\u0444\\u0440\\u0438\",\"maxDigits\":\"CVV \\u043a\\u043e\\u0434\\u044a\\u0442 \\u0442\\u0440\\u044f\\u0431\\u0432\\u0430 \\u0434\\u0430 \\u0431\\u044a\\u0434\\u0435 3 \\u0446\\u0438\\u0444\\u0440\\u0438\"}},\"mobilePopup\":{\"title\":\"\\u041f\\u043b\\u0430\\u0442\\u0438 \\u0441\\u0435\\u0433\\u0430 \\u0432 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435\\u0442\\u043e\",\"btnText\":\"\\u041a\\u043b\\u0438\\u043a\\u043d\\u0435\\u0442\\u0435, \\u0437\\u0430 \\u0434\\u0430 \\u043f\\u043b\\u0430\\u0442\\u0438\\u0442\\u0435 \\u0441\",\"redirectText\":\"\\u0410\\u043a\\u043e \\u043d\\u044f\\u043c\\u0430\\u0442\\u0435 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435\\u0442\\u043e, \\u0449\\u0435 \\u0431\\u044a\\u0434\\u0435\\u0442\\u0435 \\u043f\\u0440\\u0435\\u043d\\u0430\\u0441\\u043e\\u0447\\u0435\\u043d\\u0438 \\u0434\\u0430 \\u0433\\u043e \\u0438\\u043d\\u0441\\u0442\\u0430\\u043b\\u0438\\u0440\\u0430\\u0442\\u0435 \\u043b\\u043e\\u043a\\u0430\\u043b\\u043d\\u043e.\",\"paymentOptions\":\"\\u0421\\u043b\\u0435\\u0434\\u0432\\u0430\\u0449\\u0438\\u044f \\u043f\\u044a\\u0442, \\u043a\\u043e\\u0433\\u0430\\u0442\\u043e \\u043f\\u043b\\u0430\\u0449\\u0430\\u0442\\u0435 \\u0441 \\u043c\\u043e\\u0431\\u0438\\u043b\\u043d\\u0438\\u044f \\u0441\\u0438 \\u0442\\u0435\\u043b\\u0435\\u0444\\u043e\\u043d:\",\"payment1\":\"\\u0432 \\u043e\\u043d\\u043b\\u0430\\u0439\\u043d \\u043c\\u0430\\u0433\\u0430\\u0437\\u0438\\u043d\\u0438 \\u0438 \\u0441\\u0443\\u043f\\u0435\\u0440\\u043c\\u0430\\u0440\\u043a\\u0435\\u0442\\u0438\",\"payment2\":\"\\u0441\\u043c\\u0435\\u0442\\u043a\\u0438 \\u0437\\u0430 \\u043a\\u043e\\u043c\\u0443\\u043d\\u0430\\u043b\\u043d\\u0438 \\u0443\\u0441\\u043b\\u0443\\u0433\\u0438: \\u0435\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u0435\\u043d\\u0435\\u0440\\u0433\\u0438\\u044f, \\u0442\\u0435\\u043b\\u0435\\u0444\\u043e\\u043d, \\u0432\\u043e\\u0434\\u0430\",\"payment3\":\"\\u043e\\u0431\\u0449\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d \\u0442\\u0440\\u0430\\u043d\\u0441\\u043f\\u043e\\u0440\\u0442 \\u0438 \\u0437\\u0430\\u0440\\u0435\\u0436\\u0434\\u0430\\u043d\\u0435 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0438\"},\"paypoP\":{\"bnpl\":\"\\u041a\\u0443\\u043f\\u0438 \\u0441\\u0435\\u0433\\u0430, <1>\\u043f\\u043b\\u0430\\u0442\\u0438 \\u043f\\u043e-\\u043a\\u044a\\u0441\\u043d\\u043e</1>\",\"advantageOne\":\"\\u041f\\u043b\\u0430\\u0449\\u0430\\u0448 \\u0441\\u043b\\u0435\\u0434 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0432\\u0430\\u043d\\u0435<br/>\\u0438 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043d\\u0430 \\u043f\\u043e\\u0440\\u044a\\u0447\\u043a\\u0430\\u0442\\u0430\",\"advantageTwo\":\"\\u041c\\u043e\\u0436\\u0435\\u0448 \\u0434\\u0430 \\u0441\\u0438 \\u043f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0438\\u0448 \\u043f\\u043e\\u0432\\u0435\\u0447\\u0435,<br/>\\u0432\\u044a\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u0439 \\u0441\\u0435 \\u043e\\u0442 \\u0443\\u043d\\u0438\\u043a\\u0430\\u043b\\u043d\\u0438\\u0442\\u0435 \\u043e\\u0444\\u0435\\u0440\\u0442\\u0438 \\u0438 \\u043f\\u0440\\u043e\\u043c\\u043e\\u0446\\u0438\\u0438\",\"advantageThree\":\"\\u041f\\u043e\\u0442\\u0432\\u044a\\u0440\\u0434\\u0438 \\u0442\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 \\u0441\\u0430\\u043c\\u043e \\u0441 SMS \\u043a\\u043e\\u0434<br/>- \\u0431\\u044a\\u0440\\u0437\\u043e \\u0438 \\u0441\\u0438\\u0433\\u0443\\u0440\\u043d\\u043e\"},\"c2pError\":{\"accountInaccessible\":\"\\u0412\\u0430\\u0448\\u0438\\u044f\\u0442 \\u0430\\u043a\\u0430\\u0443\\u043d\\u0442 \\u0435 \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u044a\\u043f\\u0435\\u043d. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u043f\\u043e-\\u043a\\u044a\\u0441\\u043d\\u043e \\u0438\\u043b\\u0438 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u0435\\u0442\\u0435 \\u043f\\u043e\\u0440\\u044a\\u0447\\u043a\\u0430 \\u043a\\u0430\\u0442\\u043e \\u0433\\u043e\\u0441\\u0442.\",\"otpAccountInaccessible\":\"\\u0412\\u0430\\u0448\\u0438\\u044f\\u0442 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b \\u0432 Click to Pay \\u0435 \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u044a\\u043f\\u0435\\u043d \\u043f\\u043e\\u0440\\u0430\\u0434\\u0438 \\u043c\\u043d\\u043e\\u0433\\u043e\\u043a\\u0440\\u0430\\u0442\\u043d\\u0438 \\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043d\\u0438 \\u043e\\u043f\\u0438\\u0442\\u0438 \\u0437\\u0430 \\u0432\\u044a\\u0432\\u0435\\u0436\\u0434\\u0430\\u043d\\u0435 \\u043d\\u0430 \\u0435\\u0434\\u043d\\u043e\\u043a\\u0440\\u0430\\u0442\\u043d\\u0430 \\u043f\\u0430\\u0440\\u043e\\u043b\\u0430 (OTP). \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u043f\\u043e-\\u043a\\u044a\\u0441\\u043d\\u043e \\u0438\\u043b\\u0438 \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u0435\\u0442\\u0435 \\u043f\\u043e\\u0440\\u044a\\u0447\\u043a\\u0430 \\u043a\\u0430\\u0442\\u043e \\u0433\\u043e\\u0441\\u0442.\",\"idFormatIncorrect\":\"\\u041f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u0435\\u043d\\u0438\\u044f\\u0442 \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442 \\u043d\\u0430 ID \\u0435 \\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0435\\u043d. \\u041c\\u043e\\u043b\\u044f, \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u0442\\u0435 \\u0432\\u0430\\u0448\\u0430\\u0442\\u0430 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f.\",\"lookupFailed\":\"\\u041d\\u0435\\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u043e \\u0442\\u044a\\u0440\\u0441\\u0435\\u043d\\u0435 \\u043d\\u0430 \\u043f\\u043e\\u0442\\u0440\\u0435\\u0431\\u0438\\u0442\\u0435\\u043b.\",\"checkoutInitFailed\":\"\\u041d\\u0435\\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u043e \\u0438\\u043d\\u0438\\u0446\\u0438\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u0430\\u043d\\u0435 \\u043d\\u0430 Mastercard Checkout.\",\"mastercardInitFailed\":\"\\u041d\\u0435\\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u043e \\u0438\\u043d\\u0438\\u0446\\u0438\\u0430\\u043b\\u0438\\u0437\\u0438\\u0440\\u0430\\u043d\\u0435 \\u043d\\u0430 Mastercard.\",\"cardInvalid\":\"\\u041a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0435 \\u043d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430. \\u041c\\u043e\\u043b\\u044f, \\u0443\\u0432\\u0435\\u0440\\u0435\\u0442\\u0435 \\u0441\\u0435, \\u0447\\u0435 \\u0441\\u0442\\u0435 \\u0438\\u0437\\u0431\\u0440\\u0430\\u043b\\u0438 \\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430 \\u0441\\u044a\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u0432\\u0430\\u0449\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430.\",\"detailsIncorrect\":\"\\u0414\\u0430\\u043d\\u043d\\u0438\\u0442\\u0435 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0441\\u0430 \\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043d\\u0438. \\u041c\\u043e\\u043b\\u044f, \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u0442\\u0435 \\u043d\\u043e\\u043c\\u0435\\u0440\\u0430, CVV \\u043a\\u043e\\u0434\\u0430, \\u0434\\u0430\\u0442\\u0430\\u0442\\u0430 \\u043d\\u0430 \\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u043e\\u0441\\u0442 \\u0438 \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e.\",\"unexpectedErrorCheckout\":\"\\u0412\\u044a\\u0437\\u043d\\u0438\\u043a\\u043d\\u0430 \\u043d\\u0435\\u043e\\u0447\\u0430\\u043a\\u0432\\u0430\\u043d\\u0430 \\u0433\\u0440\\u0435\\u0448\\u043a\\u0430 \\u043f\\u0440\\u0438 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e.\",\"unforeseenError\":\"\\u0412\\u044a\\u0437\\u043d\\u0438\\u043a\\u043d\\u0430 \\u043d\\u0435\\u043f\\u0440\\u0435\\u0434\\u0432\\u0438\\u0434\\u0435\\u043d\\u0430 \\u0433\\u0440\\u0435\\u0448\\u043a\\u0430. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u043f\\u043e-\\u043a\\u044a\\u0441\\u043d\\u043e.\",\"cardProcessingError\":\"\\u0412\\u044a\\u0437\\u043d\\u0438\\u043a\\u043d\\u0430 \\u0433\\u0440\\u0435\\u0448\\u043a\\u0430 \\u043f\\u0440\\u0438 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430\\u0442\\u0430 \\u043d\\u0430 \\u0432\\u0430\\u0448\\u0430\\u0442\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e.\",\"reqTimeOut\":\"\\u041d\\u0435 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0445\\u043c\\u0435 \\u043e\\u0442\\u0433\\u043e\\u0432\\u043e\\u0440 \\u043d\\u0430\\u0432\\u0440\\u0435\\u043c\\u0435. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e.\"},\"error\":{\"00\":\"\\u0422\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 \\u0435 \\u043e\\u0434\\u043e\\u0431\\u0440\\u0435\\u043d\\u0430\",\"invalid_card_number_title\":\"\\u041d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043d\\u0438 \\u0434\\u0430\\u043d\\u043d\\u0438 \\u0437\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430\",\"invalid_card_number_description\":\"\\u0414\\u0430\\u043d\\u043d\\u0438\\u0442\\u0435 \\u0437\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0441\\u0430 \\u0432\\u044a\\u0432\\u0435\\u0434\\u0435\\u043d\\u0438 \\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043d\\u043e. \\u041c\\u043e\\u043b\\u044f, \\u0432\\u044a\\u0432\\u0435\\u0434\\u0435\\u0442\\u0435 \\u0433\\u0438 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u0432\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u043d\\u043e.\",\"closed_card_title\":\"\\u0417\\u0430\\u0442\\u0432\\u043e\\u0440\\u0435\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\",\"closed_card_description\":\"\\u0418\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u043d\\u0430\\u0442\\u0430 \\u0437\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435 \\u043a\\u0430\\u0440\\u0442\\u0430 \\u0435 \\u0437\\u0430\\u0442\\u0432\\u043e\\u0440\\u0435\\u043d\\u0430. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u0441 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430.\",\"expired_card_title\":\"\\u041d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0435\\u043d \\u0441\\u0440\\u043e\\u043a \\u043d\\u0430 \\u0433\\u043e\\u0434\\u043d\\u043e\\u0441\\u0442\",\"expired_card_description\":\"\\u0418\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u043d\\u0430\\u0442\\u0430 \\u0437\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435 \\u043a\\u0430\\u0440\\u0442\\u0430 \\u0435 \\u0438\\u0437\\u0442\\u0435\\u043a\\u043b\\u0430 \\u0438\\u043b\\u0438 \\u0441\\u0442\\u0435 \\u0432\\u044a\\u0432\\u0435\\u043b\\u0438 \\u043d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430 \\u0434\\u0430\\u0442\\u0430 \\u043d\\u0430 \\u0438\\u0437\\u0442\\u0438\\u0447\\u0430\\u043d\\u0435. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u0441 \\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430.\",\"not_sufficient_funds_title\":\"\\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u044a\\u0447\\u043d\\u0438 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f\",\"not_sufficient_funds_description\":\"\\u041f\\u043e \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430, \\u0438\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u043d\\u0430 \\u0437\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435, \\u043d\\u044f\\u043c\\u0430 \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u044a\\u0447\\u043d\\u043e \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432\\u0430. \\u041c\\u043e\\u043b\\u044f, \\u0443\\u0432\\u0435\\u0440\\u0435\\u0442\\u0435 \\u0441\\u0435, \\u0447\\u0435 \\u0438\\u043c\\u0430\\u0442\\u0435 \\u0434\\u043e\\u0441\\u0442\\u0430\\u0442\\u044a\\u0447\\u043d\\u043e \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432\\u0430 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u0441\\u0438, \\u0438\\u043b\\u0438 \\u0438\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u0439\\u0442\\u0435 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430 \\u0431\\u0430\\u043d\\u043a\\u043e\\u0432\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430.\",\"invalid_cw_title\":\"CVV2/CVV \\u0433\\u0440\\u0435\\u0448\\u043d\\u043e\",\"invalid_cw_description\":\"\\u041a\\u043e\\u0434\\u044a\\u0442 CVV \\u0435 \\u0432\\u044a\\u0432\\u0435\\u0434\\u0435\\u043d \\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043d\\u043e. \\u041c\\u043e\\u043b\\u044f, \\u0432\\u044a\\u0432\\u0435\\u0434\\u0435\\u0442\\u0435 \\u0432\\u043d\\u0438\\u043c\\u0430\\u0442\\u0435\\u043b\\u043d\\u043e \\u0434\\u0430\\u043d\\u043d\\u0438\\u0442\\u0435 \\u0437\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430.\",\"issuer_error_title\":\"\\u0413\\u0440\\u0435\\u0448\\u043a\\u0430 \\u0432 \\u0438\\u0437\\u0434\\u0430\\u0442\\u0435\\u043b\\u0441\\u043a\\u0430\\u0442\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430\",\"issuer_error_description\":\"\\u0418\\u0437\\u0434\\u0430\\u0442\\u0435\\u043b\\u0441\\u043a\\u0430\\u0442\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u043d\\u0435 \\u0435 \\u043f\\u0440\\u0438\\u0435\\u043b\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e. \\u041c\\u043e\\u043b\\u044f, \\u0438\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u0439\\u0442\\u0435 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430 (\\u0438\\u0437\\u0434\\u0430\\u0434\\u0435\\u043d\\u0430 \\u043e\\u0442 \\u0434\\u0440\\u0443\\u0433\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430) \\u0438\\u043b\\u0438 \\u0441\\u0435 \\u0441\\u0432\\u044a\\u0440\\u0436\\u0435\\u0442\\u0435 \\u0441 \\u0438\\u0437\\u0434\\u0430\\u0442\\u0435\\u043b\\u0441\\u043a\\u0430\\u0442\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430, \\u0437\\u0430 \\u043a\\u043e\\u044f\\u0442\\u043e \\u0442\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 \\u0435 \\u0431\\u0438\\u043b\\u0430 \\u043e\\u0442\\u0445\\u0432\\u044a\\u0440\\u043b\\u0435\\u043d\\u0430.\",\"invalid_settings_title\":\"\\u041d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043d\\u0438 \\u043d\\u0430\\u0441\\u0442\\u0440\\u043e\\u0439\\u043a\\u0438 \\u043d\\u0430 \\u0442\\u044a\\u0440\\u0433\\u043e\\u0432\\u0435\\u0446\\u0430\",\"invalid_settings_description\":\"\\u0421\\u043c\\u0435\\u0442\\u043a\\u0430\\u0442\\u0430, \\u043a\\u043e\\u044f\\u0442\\u043e \\u0441\\u0435 \\u043e\\u043f\\u0438\\u0442\\u0432\\u0430\\u0442\\u0435 \\u0434\\u0430 \\u043f\\u043b\\u0430\\u0442\\u0438\\u0442\\u0435, \\u0438\\u043c\\u0430 \\u043d\\u0435\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043d\\u0438 \\u043d\\u0430\\u0441\\u0442\\u0440\\u043e\\u0439\\u043a\\u0438. \\u041c\\u043e\\u043b\\u044f, \\u0441\\u0432\\u044a\\u0440\\u0436\\u0435\\u0442\\u0435 \\u0441\\u0435 \\u0441 \\u043d\\u0430\\u0441 \\u0437\\u0430 \\u0434\\u043e\\u043f\\u044a\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u043d\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430.\",\"transaction_not_allowed_title\":\"\\u0422\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 \\u043d\\u0435 \\u0435 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0430\",\"transaction_not_allowed_description\":\"\\u0418\\u0437\\u0434\\u0430\\u0442\\u0435\\u043b\\u0441\\u043a\\u0430\\u0442\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430 \\u043d\\u0435 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0430\\u0432\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e. \\u041c\\u043e\\u043b\\u044f, \\u0438\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u0439\\u0442\\u0435 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430 (\\u0438\\u0437\\u0434\\u0430\\u0434\\u0435\\u043d\\u0430 \\u043e\\u0442 \\u0434\\u0440\\u0443\\u0433\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430) \\u0438\\u043b\\u0438 \\u0441\\u0435 \\u0441\\u0432\\u044a\\u0440\\u0436\\u0435\\u0442\\u0435 \\u0441 \\u0438\\u0437\\u0434\\u0430\\u0442\\u0435\\u043b\\u0441\\u043a\\u0430\\u0442\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430, \\u0437\\u0430 \\u043a\\u043e\\u044f\\u0442\\u043e \\u0442\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 \\u0435 \\u0431\\u0438\\u043b\\u0430 \\u043e\\u0442\\u0445\\u0432\\u044a\\u0440\\u043b\\u0435\\u043d\\u0430.\",\"declined_title\":\"\\u041f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e \\u0435 \\u043e\\u0442\\u043a\\u0430\\u0437\\u0430\\u043d\\u043e\",\"declined_description\":\"\\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u0441 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430.\",\"hard_declined_title\":\"\\u041f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e \\u0435 \\u043e\\u0442\\u043a\\u0430\\u0437\\u0430\\u043d\\u043e\",\"hard_declined_description\":\"\\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u0441 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430.\",\"declined_3D_secure_title\":\"\\u041f\\u0440\\u043e\\u0432\\u0430\\u043b\\u0438\\u043b\\u0430 \\u0441\\u0435 3-D Secure \\u0438\\u0434\\u0435\\u043d\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0446\\u0438\\u044f\",\"declined_3D_secure_description\":\"3-D Secure \\u0438\\u0434\\u0435\\u043d\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0446\\u0438\\u044f\\u0442\\u0430 \\u0435 \\u043d\\u0435\\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u0430. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e.\",\"general_error_title\":\"\\u041e\\u0431\\u0449\\u0430 \\u0433\\u0440\\u0435\\u0448\\u043a\\u0430\",\"general_error_description\":\"\\u0412\\u044a\\u0437\\u043d\\u0438\\u043a\\u043d\\u0430 \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u0430 \\u0433\\u0440\\u0435\\u0448\\u043a\\u0430 \\u043f\\u0440\\u0438 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430\\u0442\\u0430 \\u043d\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e \\u043f\\u043e-\\u043a\\u044a\\u0441\\u043d\\u043e.\",\"payment_locked_title\":\"\\u0410\\u0432\\u0442\\u0435\\u043d\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0446\\u0438\\u044f \\u0432 \\u0445\\u043e\\u0434\",\"payment_locked_description\":\"\\u0418\\u043c\\u0430\\u0442\\u0435 \\u0447\\u0430\\u043a\\u0430\\u0449\\u043e \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435. \\u0417\\u0430 \\u0434\\u0430 \\u0441\\u0442\\u0435 \\u0441\\u0438\\u0433\\u0443\\u0440\\u043d\\u0438, \\u0447\\u0435 \\u043d\\u044f\\u043c\\u0430 \\u0434\\u0430 \\u0431\\u044a\\u0434\\u0435\\u0442\\u0435 \\u0442\\u0430\\u043a\\u0441\\u0443\\u0432\\u0430\\u043d\\u0438 \\u0434\\u0432\\u0430 \\u043f\\u044a\\u0442\\u0438, \\u043c\\u043e\\u043b\\u044f, \\u0438\\u0437\\u0447\\u0430\\u043a\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0449\\u0435 {{count}} \\u043c\\u0438\\u043d\\u0443\\u0442\\u0438, \\u043f\\u0440\\u0435\\u0434\\u0438 \\u0434\\u0430 \\u043e\\u043f\\u0438\\u0442\\u0430\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e.\",\"payment_locked_BNPL_title\":\"\\u041e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u043d\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e\",\"payment_locked_BNPL_description\":\"\\u0410\\u043a\\u043e \\u0432\\u0435\\u0447\\u0435 \\u0441\\u0442\\u0435 \\u0432\\u044a\\u0432\\u0435\\u043b\\u0438 \\u0434\\u0430\\u043d\\u043d\\u0438\\u0442\\u0435 \\u0441\\u0438, \\u043c\\u043e\\u043b\\u044f, \\u0438\\u0437\\u0447\\u0430\\u043a\\u0430\\u0439\\u0442\\u0435 \\u0434\\u043e\\u043f\\u044a\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u043d\\u043e {{count}} \\u043c\\u0438\\u043d\\u0443\\u0442\\u0438 \\u0437\\u0430 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u043d\\u0430 \\u