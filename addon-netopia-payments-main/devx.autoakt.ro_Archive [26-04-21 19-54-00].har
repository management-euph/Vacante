5 \\u0441 \\u043a\\u0430\\u0440\\u0442\\u0430\",\"merchant-details\":\"\\u0414\\u0430\\u043d\\u043d\\u0438 \\u0437\\u0430 \\u0442\\u044a\\u0440\\u0433\\u043e\\u0432\\u0435\\u0446\\u0430\",\"card-number\":\"\\u041d\\u043e\\u043c\\u0435\\u0440 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\",\"expiry-date\":\"\\u0412\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430 \\u0434\\u043e\",\"cvv\":\"CVV/CVC\",\"name-card\":\"\\u0422\\u0438\\u0442\\u0443\\u043b\\u044f\\u0440 \\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430\\u0442\\u0430\",\"cards-options\":\"\\u041e\\u043f\\u0446\\u0438\\u0438 \\u0437\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0438\",\"zero-interest\":\"\\u0431\\u0435\\u0437\\u043b\\u0438\\u0445\\u0432\\u0435\\u043d\\u0438 \\u0432\\u043d\\u043e\\u0441\\u043a\\u0438\",\"choose-installments\":\"\\u0418\\u0437\\u0431\\u0435\\u0440\\u0435\\u0442\\u0435 \\u0431\\u0440\\u043e\\u044f \\u043d\\u0430 \\u0432\\u043d\\u043e\\u0441\\u043a\\u0438\\u0442\\u0435\",\"bonus-points\":\"\\u0411\\u043e\\u043d\\u0443\\u0441 \\u0442\\u043e\\u0447\\u043a\\u0438 \\u043d\\u0430\\u043b\\u0438\\u0447\\u043d\\u0438\",\"pay\":\"\\u041f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\",\"pay-easier\":\"\\u041f\\u043b\\u0430\\u0449\\u0430\\u0439\\u0442\\u0435 \\u043f\\u043e-\\u043b\\u0435\\u0441\\u043d\\u043e\",\"scan-app\":\"\\u0418\\u0437\\u043f\\u043e\\u043b\\u0437\\u0432\\u0430\\u0439\\u0442\\u0435 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435\\u0442\\u043e <1>{{name}}</1>, \\u0437\\u0430 \\u0434\\u0430 \\u0441\\u043a\\u0430\\u043d\\u0438\\u0440\\u0430\\u0442\\u0435 \\u0438 \\u043f\\u043b\\u0430\\u0442\\u0438\\u0442\\u0435 \\u043d\\u0435\\u0437\\u0430\\u0431\\u0430\\u0432\\u043d\\u043e!\",\"install-app\":\"\\u0418\\u043d\\u0441\\u0442\\u0430\\u043b\\u0438\\u0440\\u0430\\u0439\\u0442\\u0435 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435\\u0442\\u043e <1>{{name}}</1> \\u0438 \\u043f\\u043b\\u0430\\u0449\\u0430\\u0439\\u0442\\u0435 \\u043d\\u0435\\u0437\\u0430\\u0431\\u0430\\u0432\\u043d\\u043e!\",\"gdpr\":\"\\u041a\\u0430\\u0442\\u043e \\u0432\\u044a\\u0432\\u0435\\u0434\\u0435\\u0442\\u0435 \\u043f\\u043e\\u0438\\u0441\\u043a\\u0430\\u043d\\u0438\\u0442\\u0435 \\u0434\\u0430\\u043d\\u043d\\u0438 \\u043d\\u0430 \\u0442\\u0430\\u0437\\u0438 \\u0441\\u0442\\u0440\\u0430\\u043d\\u0438\\u0446\\u0430 \\u0438 \\u043f\\u0440\\u043e\\u0434\\u044a\\u043b\\u0436\\u0438\\u0442\\u0435 \\u0441 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e, \\u0432\\u0438\\u0435 \\u0441\\u0435 \\u0441\\u044a\\u0433\\u043b\\u0430\\u0441\\u044f\\u0432\\u0430\\u0442\\u0435 \\u0441 <1>\\u043e\\u0431\\u0449\\u0438\\u0442\\u0435 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f</1> \\u043d\\u0430 NETOPIA Payments.\",\"gdpr2\":\" \\u0412 <1>\\u0411\\u0435\\u043b\\u0435\\u0436\\u043a\\u0430\\u0442\\u0430 \\u0437\\u0430 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f \\u0437\\u0430 GDPR</1> \\u0449\\u0435 \\u043d\\u0430\\u043c\\u0435\\u0440\\u0438\\u0442\\u0435 \\u0446\\u044f\\u043b\\u0430\\u0442\\u0430 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f \\u0437\\u0430 \\u0442\\u043e\\u0432\\u0430 \\u043a\\u0430\\u043a \\u0441\\u0435 \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u0432\\u0430\\u0442 \\u043b\\u0438\\u0447\\u043d\\u0438\\u0442\\u0435 \\u0434\\u0430\\u043d\\u043d\\u0438.\",\"validate-data\":\"\\u041f\\u043e\\u0442\\u0432\\u044a\\u0440\\u0434\\u0435\\u0442\\u0435 \\u0434\\u0430\\u043d\\u043d\\u0438\\u0442\\u0435 \\u0441\\u0438\",\"enter-details\":\"\\u0412\\u044a\\u0432\\u0435\\u0434\\u0435\\u0442\\u0435 \\u0434\\u0430\\u043d\\u043d\\u0438\\u0442\\u0435 \\u0441\\u0438\",\"mobile\":\"\\u0422\\u0435\\u043b\\u0435\\u0444\\u043e\\u043d\",\"email\":\"\\u0415-\\u043c\\u0435\\u0439\\u043b \\u0430\\u0434\\u0440\\u0435\\u0441\",\"address\":\"\\u0410\\u0434\\u0440\\u0435\\u0441\",\"validate\":\"I \\u0432\\u0430\\u043b\\u0438\\u0434\\u0438\\u0440\\u0430\\u043d\\u0438\",\"error-message\":\"\\u0422\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 \\u0432\\u0438 \\u043d\\u0435 \\u0435 \\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u0430\",\"error-details\":\"\\u0417\\u0430 \\u043f\\u043e\\u0432\\u0435\\u0447\\u0435 \\u0438\\u043d\\u0444\\u043e\\u0440\\u043c\\u0430\\u0446\\u0438\\u044f, \\u043c\\u043e\\u043b\\u044f \\u0441\\u0432\\u044a\\u0440\\u0436\\u0435\\u0442\\u0435 \\u0441\\u0435 \\u0441 \\u0432\\u0430\\u0448\\u0430\\u0442\\u0430 \\u0431\\u0430\\u043d\\u043a\\u0430.\",\"success-message\":\"\\u041f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\\u0442\\u043e \\u0432\\u0438 \\u0431\\u0435\\u0448\\u0435 \\u0443\\u0441\\u043f\\u0435\\u0448\\u043d\\u043e \\u043e\\u0431\\u0440\\u0430\\u0431\\u043e\\u0442\\u0435\\u043d\\u043e\",\"pending-message\":\"\\u0422\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f \\u0432 \\u0445\\u043e\\u0434\",\"retry\":\"\\u041e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e\",\"cancel\":\"\\u041e\\u0442\\u043a\\u0430\\u0437\",\"success\":\"Success\",\"mobilpay-id\":\"mobilPay Wallet ID\",\"name\":\"\\u041f\\u044a\\u043b\\u043d\\u043e \\u0438\\u043c\\u0435\",\"transaction-no\":\"\\u041d\\u043e\\u043c\\u0435\\u0440 \\u043d\\u0430 \\u0442\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430\",\"authorization-code\":\"\\u041a\\u043e\\u0434 \\u0437\\u0430 \\u043e\\u0442\\u043e\\u0440\\u0438\\u0437\\u0430\\u0446\\u0438\\u044f \\u043d\\u0430 \\u0442\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430\",\"transaction-ref\":\"\\u0420\\u0435\\u0444\\u0435\\u0440\\u0435\\u043d\\u0446\\u0438\\u044f \\u043d\\u0430 \\u0442\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 (RRN)\",\"date-time\":\"\\u0414\\u0430\\u0442\\u0430 \\u0438 \\u0447\\u0430\\u0441\",\"amount\":\"\\u0421\\u0443\\u043c\\u0430\",\"details\":\"\\u041f\\u043e\\u0434\\u0440\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438\",\"credit\":\"\\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\",\"mobilPay\":\"mobilPay wallet\",\"googlePay\":\"Google Pay\",\"applePay\":\"Apple Pay\",\"paypo\":\"PayPo\",\"clickPay\":\"Click2Pay\",\"read-more\":\"\\u041f\\u0440\\u043e\\u0447\\u0435\\u0442\\u0435\\u0442\\u0435 \\u043f\\u043e\\u0432\\u0435\\u0447\\u0435\",\"show-less\":\"\\u041f\\u043e\\u043a\\u0430\\u0436\\u0438 \\u043f\\u043e-\\u043c\\u0430\\u043b\\u043a\\u043e\",\"backToShop\":\"\\u041d\\u0430\\u0437\\u0430\\u0434 \\u043a\\u044a\\u043c \\u043c\\u0430\\u0433\\u0430\\u0437\\u0438\\u043d\\u0430\",\"total\":\"\\u041f\\u043b\\u0430\\u0442\\u0438\",\"with\":\"\\u0441\",\"without-installments\":\"\\u0411\\u0435\\u0437 \\u0440\\u0430\\u0437\\u0441\\u0440\\u043e\\u0447\\u0432\\u0430\\u043d\\u0435\",\"formatDate\":\"MM/YY\",\"cardNamePlaceholder\":\"John Doe\",\"emailPlaceholder\":\"doe@myemail.com\",\"invalidPhone\":\"\\u041d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u0435\\u043d \\u0442\\u0435\\u043b\\u0435\\u0444\\u043e\\u043d\\u0435\\u043d \\u043d\\u043e\\u043c\\u0435\\u0440\",\"invalidAddress\":\"\\u041d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u0435\\u043d \\u0430\\u0434\\u0440\\u0435\\u0441\",\"onlyDigits\":\"\\u041f\\u043e\\u0437\\u0432\\u043e\\u043b\\u0435\\u043d\\u0438 \\u0441\\u0430 \\u0441\\u0430\\u043c\\u043e \\u0446\\u0438\\u0444\\u0440\\u0438\",\"invalidEmail\":\"\\u041d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u0435\\u043d \\u0438\\u043c\\u0435\\u0439\\u043b\",\"invalidPostalCode\":\"\\u041d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u0435\\u043d \\u043f\\u043e\\u0449\\u0435\\u043d\\u0441\\u043a\\u0438 \\u043a\\u043e\\u0434\",\"descriptionOney\":\"\\u041e\\u043d\\u043b\\u0430\\u0439\\u043d \\u0440\\u0430\\u0437\\u0441\\u0440\\u043e\\u0447\\u0432\\u0430\\u043d\\u0435 \\u0441 \\u0434\\u0435\\u0431\\u0438\\u0442\\u043d\\u0430 \\u043a\\u0430\\u0440\\u0442\\u0430 \\u0447\\u0440\\u0435\\u0437 Oney\",\"descriptionPaypo\":\"\\u041f\\u043b\\u0430\\u0442\\u0438 \\u043f\\u043e\\u043a\\u0443\\u043f\\u043a\\u0438\\u0442\\u0435 \\u0441\\u0438 \\u0434\\u043e 30 \\u0434\\u043d\\u0438, \\u0431\\u0435\\u0437 \\u043b\\u0438\\u0445\\u0432\\u0430\",\"back\":\"\\u041d\\u0430\\u0437\\u0430\\u0434\",\"selectPaymnet\":\"\\u0418\\u0437\\u0431\\u0435\\u0440\\u0435\\u0442\\u0435 \\u043c\\u0435\\u0442\\u043e\\u0434\\u0430 \\u043d\\u0430 \\u043f\\u043b\\u0430\\u0449\\u0430\\u043d\\u0435\",\"copied\":\"\\u041a\\u043e\\u043f\\u0438\\u0440\\u0430\\u043d\\u043e!\",\"copy\":\"\\u041a\\u043e\\u043f\\u0438\\u0440\\u0430\\u0439\",\"BNPL\":\"\\u041a\\u0443\\u043f\\u0438 \\u0441\\u0435\\u0433\\u0430, \\u043f\\u043b\\u0430\\u0442\\u0438 \\u043f\\u043e-\\u043a\\u044a\\u0441\\u043d\\u043e\",\"error-message-bnpl\":\"\\u0422\\u0440\\u0430\\u043d\\u0437\\u0430\\u043a\\u0446\\u0438\\u044f\\u0442\\u0430 \\u0432\\u0438 \\u0441\\u0435 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0432\\u0430\",\"addressPlaceholder\":\"\\u2116 \\u0443\\u043b\\u0438\\u0446\\u0430\",\"street\":\"\\u0423\\u043b\\u0438\\u0446\\u0430\",\"city\":\"\\u0413\\u0440\\u0430\\u0434\",\"cityPlaceholder\":\"\\u0411\\u0443\\u043a\\u0443\\u0440\\u0435\\u0449\",\"invalidCity\":\"\\u0413\\u0440\\u0430\\u0434\\u044a\\u0442 \\u043d\\u0435 \\u0435 \\u0432\\u0430\\u043b\\u0438\\u0434\\u0435\\u043d\",\"generalError\":\"\\u0412\\u044a\\u0437\\u043d\\u0438\\u043a\\u043d\\u0430 \\u0433\\u0440\\u0435\\u0448\\u043a\\u0430. \\u041c\\u043e\\u043b\\u044f, \\u043e\\u043f\\u0438\\u0442\\u0430\\u0439\\u0442\\u0435 \\u043e\\u0442\\u043d\\u043e\\u0432\\u043e.\",\"postalCode\":\"\\u041f\\u043e\\u0449\\u0435\\u043d\\u0441\\u043a\\u0438 \\u043a\\u043e\\u0434\",\"discount\":\"\\u041e\\u0442\\u0441\\u0442\\u044a\\u043f\\u043a\\u0430\",\"discountDetails\":\"\\u0418\\u043c\\u0430\\u0442\\u0435 \\u043e\\u0442\\u0441\\u0442\\u044a\\u043f\\u043a\\u0430, \\u0441\\u0432\\u044a\\u0440\\u0437\\u0430\\u043d\\u0430 \\u0441 \\u0442\\u0430\\u0437\\u0438 \\u043a\\u0430\\u0440\\u0442\\u0430, \\u043d\\u0430 \\u0441\\u0442\\u043e\\u0439\\u043d\\u043e\\u0441\\u0442