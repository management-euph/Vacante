                        </div>\n        </div>                                        \n            <div class=\"row-fluid\">                        <div class=\"span16  ty-cs-controller-checkout ty-cs-mode-complete  ty-footer-grid__full-width footer-copyright\" >\n                                    <div class=\"row-fluid\">                        <div class=\"span8  ty-cs-controller-checkout ty-cs-mode-complete  \" >\n                                    <div class=\" ty-float-left\" id=\"snapping_id_18\">\n                <p class=\"bottom-copyright\">\n    &copy;\n            2004 -\n        \n    2026 CS-Cart. &nbsp;Powered by <a class=\"bottom-copyright bottom-copyright__link\" href=\"https://www.cs-cart.com?utm_source=Powered+by&amp;utm_medium=referral&amp;utm_campaign=footer&amp;utm_content=devx.autoakt.ro\" target=\"_blank\">CS-Cart - Shopping Cart Software</a>\n</p>\n                    <!--snapping_id_18--></div>\n                            </div>\n                                                \n                                    <div class=\"span8  ty-cs-controller-checkout ty-cs-mode-complete  \" >\n                                    <div class=\" ty-float-right\" id=\"snapping_id_19\">\n                <div class=\"ty-payment-icons\">\n        <span class=\"ty-payment-icons__item twocheckout\">&nbsp;</span>\n    <span class=\"ty-payment-icons__item paypal\">&nbsp;</span>\n    <span class=\"ty-payment-icons__item mastercard\">&nbsp;</span>\n    <span class=\"ty-payment-icons__item visa\">&nbsp;</span>\n    \n</div>\n\n                    <!--snapping_id_19--></div>\n                            </div>\n        </div>\n                            </div>\n        </div>    \n        </div>\n    \n\n</div>\n\n        \n\n            \n        <!--tygh_main_container--></div>\n\n        \n        \n<div data-ca-navbar-mobile=\"main\" class=\"ty-navbar-mobile\" id=\"navbar_mobile\"><div data-ca-navbar-mobile=\"inner\" class=\"ty-navbar-mobile__inner\"><di