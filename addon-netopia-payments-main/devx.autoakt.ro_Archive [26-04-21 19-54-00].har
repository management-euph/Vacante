in_litecheckout_login_block_inner\\\" name=\\\"user_login\\\" size=\\\"30\\\" value=\\\"\\\" class=\\\"ty-login__input cm-focus\\\" \\/>\\n        <\\/div>\\n\\n        <div class=\\\"ty-control-group ty-password-forgot\\\">\\n            <label for=\\\"psw_litecheckout_login_block_inner\\\" class=\\\"ty-login__filed-label ty-control-group__label ty-password-forgot__label cm-required\\\">Password<\\/label><a href=\\\"https:\\/\\/devx.autoakt.ro\\/index.php?dispatch=auth.recover_password\\\" class=\\\"ty-password-forgot__a\\\"  tabindex=\\\"5\\\">Forgot your password?<\\/a>\\n            <input type=\\\"password\\\" id=\\\"psw_litecheckout_login_block_inner\\\" name=\\\"password\\\" size=\\\"30\\\" value=\\\"\\\" class=\\\"ty-login__input\\\" maxlength=\\\"32\\\" \\/>\\n        <\\/div>\\n\\n                    \\n            <div class=\\\"ty-login-reglink ty-center\\\">\\n                <a class=\\\"ty-login-reglink__a\\\" href=\\\"https:\\/\\/devx.autoakt.ro\\/profiles-add\\/\\\" rel=\\\"nofollow\\\">Register for a new account<\\/a>\\n            <\\/div>\\n        \\n        \\n        \\n                    <div class=\\\"buttons-container clearfix\\\">\\n                <div class=\\\"ty-float-right\\\">\\n                        \\n     <button  class=\\\"ty-btn__login ty-btn__secondary ty-btn\\\" type=\\\"submit\\\" name=\\\"dispatch[auth.login]\\\" >Sign in<\\/button>\\n\\n                <\\/div>\\n                <div class=\\\"ty-login__remember-me\\\">\\n                    <label for=\\\"remember_me_litecheckout_login_block_inner\\\" class=\\\"ty-login__remember-me-label\\\"><input class=\\\"checkbox\\\" type=\\\"checkbox\\\" name=\\\"remember_me\\\" id=\\\"remember_me_litecheckout_login_block_inner\\\" value=\\\"Y\\\" \\/>Remember me<\\/label>\\n                <\\/div>\\n            <\\/div>\\n        \\n    <input type=\\\"hidden\\\" name=\\\"security_hash\\\" class=\\\"cm-no-hide-input\\\" value=\\\"9bb29d3ff4fbbd8f1e38129c8306c562\\\" \\/><\\/form