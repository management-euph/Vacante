msgid "Geocoding contact email"
msgstr "Email de contact pentru geocodare"

msgctxt "SettingsTooltips::travel_core::geocoding_contact_email"
msgid "Sent in the User-Agent of Nominatim requests — the public instance's usage policy requires a way to contact you. Geocoding will not run without it."
msgstr "Trimis în User-Agent-ul cererilor Nominatim — politica de utilizare a instanței publice cere o modalitate de contact. Geocodarea nu rulează fără acesta."

