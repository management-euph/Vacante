msgctxt "Addons::name::eurosite"
msgid "Eurosite Touring"
msgstr "Eurosite Touring"

msgctxt "Addons::description::eurosite"
msgid "Integration with the Eurosite XML web service (touringit.ro platform) for hotel search and bookings. Static data, availability + price search, product details and add/get/cancel booking."
msgstr "Integrare cu serviciul web XML Eurosite (platforma touringit.ro) pentru căutare hoteluri și rezervări. Date statice, căutare disponibilitate + preț, detalii produs și adăugare/interogare/anulare rezervare."

msgctxt "SettingsSections::eurosite::general"
msgid "General"
msgstr "General"

msgctxt "SettingsOptions::eurosite::api_header"
msgid "Eurosite API connection"
msgstr "Conexiune API Eurosite"

msgctxt "SettingsOptions::eurosite::api_url"
msgid "API endpoint URL"
msgstr "Adresă endpoint API"

msgctxt "SettingsTooltips::eurosite::api_url"
msgid "The single XML web-service URL every RequestType is POSTed to (provided by the Touroperator)."
msgstr "Adresa unică a serviciului web XML către care se trimit toate tipurile de cereri (furnizată de Touroperator)."

msgctxt "SettingsOptions::eurosite::api_user"
msgid "API user"
msgstr "Utilizator API"

msgctxt "SettingsOptions::eurosite::api_password"
msgid "API password"
msgstr "Parolă API"

msgctxt "SettingsTooltips::eurosite::api_password"
msgid "Credentials are embedded in every request's AuditInfo. Without a valid account the service answers every request with error -1000 (\"You are not authorised to access this server!\")."
msgstr "Credențialele sunt incluse în AuditInfo la fiecare cerere. Fără un cont valid serviciul răspunde la orice cerere cu eroarea -1000 („You are not authorised to access this server!”)."

msgctxt "SettingsOptions::eurosite::tourop_code"
msgid "Tour operator code"
msgstr "Cod touroperator"

msgctxt "SettingsTooltips::eurosite::tourop_code"
msgid "The operator code embedded in search/booking payloads. Ask Eurosite which code your account uses — own-hotels data on the Laguna platform reports \"LA\"."
msgstr "Codul de operator inclus în cererile de căutare/rezervare. Întrebați Eurosite ce cod folosește contul dvs. — datele de hoteluri proprii de pe platforma Laguna raportează „LA”."

msgctxt "SettingsOptions::eurosite::default_currency"
msgid "Default currency"
msgstr "Monedă implicită"

msgctxt "SettingsOptions::eurosite::default_language"
msgid "Default API language"
msgstr "Limbă implicită API"

msgctxt "SettingsOptions::eurosite::allow_insecure_api"
msgid "Allow insecure (HTTP) API connection"
msgstr "Permite conexiune API nesecurizată (HTTP)"

msgctxt "SettingsTooltips::eurosite::allow_insecure_api"
msgid "Permit sending API credentials over unencrypted HTTP (dev only). Disable once the API URL uses https:// — connections then hard-fail rather than leak credentials in plaintext."
msgstr "Permite trimiterea credențialelor API prin HTTP necriptat (doar pentru dezvoltare). Dezactivați când adresa API folosește https:// — conexiunile vor eșua în loc să expună credențialele în clar."

msgctxt "SettingsOptions::eurosite::payment_terms_text"
msgid "Payment terms text"
msgstr "Text condiții de plată"

msgctxt "SettingsTooltips::eurosite::payment_terms_text"
msgid "Shown in the \"Cancellation and payment terms\" window, one line per line: the Eurosite API gives no payment schedule before booking, so the store writes these lines."
msgstr "Afișat în fereastra „Condiții de anulare și plată”, câte un rând pe linie: API-ul Eurosite nu oferă un calendar de plată înainte de rezervare, așa că magazinul scrie aceste rânduri."

msgctxt "SettingsOptions::eurosite::cron_header"
msgid "Cron"
msgstr "Cron"

msgctxt "SettingsOptions::eurosite::cron_access_key"
msgid "Cron access key"
msgstr "Cheie de acces cron"

msgctxt "SettingsTooltips::eurosite::cron_access_key"
msgid "Shared secret for the sync cron endpoints (index.php?dispatch=eurosite_cron.run&access_key=KEY&cron_mode=... and app/addons/eurosite/cron.php). Change it from the default before going live."
msgstr "Secret partajat pentru endpoint-urile cron de sincronizare (index.php?dispatch=eurosite_cron.run&access_key=KEY&cron_mode=... și app/addons/eurosite/cron.php). Schimbați valoarea implicită înainte de producție."

msgctxt "SettingsOptions::eurosite::resilience_header"
msgid "Resilience"
msgstr "Reziliență"

msgctxt "SettingsOptions::eurosite::api_max_retries"
msgid "Max retries"
msgstr "Reîncercări maxime"

msgctxt "SettingsOptions::eurosite::api_timeout"
msgid "Request timeout (s)"
msgstr "Timeout cerere (s)"

msgctxt "SettingsOptions::eurosite::circuit_breaker_threshold"
msgid "Circuit breaker threshold"
msgstr "Prag circuit breaker"

msgctxt "SettingsOptions::eurosite::circuit_breaker_timeout"
msgid "Circuit breaker cooldown (s)"
msgstr "Cooldown circuit breaker (s)"

msgctxt "SettingsOptions::eurosite::products_header"
msgid "Hotels and products"
msgstr "Hoteluri și produse"

msgctxt "SettingsOptions::eurosite::hotels_category_id"
msgid "CS-Cart category ID for Eurosite hotels"
msgstr "ID categorie CS-Cart pentru hoteluri Eurosite"

msgctxt "SettingsTooltips::eurosite::hotels_category_id"
msgid "Root category under which hotel products are created. Country and destination sub-categories are generated automatically."
msgstr "Categorie rădăcină în care se creează produsele hoteliere. Sub-categoriile pe țări și destinații se generează automat."

msgctxt "SettingsOptions::eurosite::products_without_images"
msgid "Create products for hotels without images"
msgstr "Creează produse pentru hoteluri fără imagini"

msgctxt "SettingsTooltips::eurosite::products_without_images"
msgid "Off: hotels with no pictures and no cover image are skipped and created later, once pictures arrive. On: they become products too, marked \"no images\" in the hotel list."
msgstr "Dezactivat: hotelurile fără poze și fără imagine de copertă sunt omise și create mai târziu, când apar pozele. Activat: devin și ele produse, marcate „fără imagini” în lista de hoteluri."

msgctxt "SettingsOptions::eurosite::availability_near_days"
msgid "Availability check: days ahead"
msgstr "Verificare disponibilitate: zile înainte"

msgctxt "SettingsTooltips::eurosite::availability_near_days"
msgid "Check-in dates to check, as days from today, comma separated (e.g. 14, 30, 60). A hotel counts as available when any checked date has an Immediate offer."
msgstr "Datele de check-in verificate, ca zile de azi înainte, separate prin virgulă (ex. 14, 30, 60). Un hotel este disponibil când oricare dată verificată are o ofertă Imediată."

msgctxt "SettingsOptions::eurosite::availability_season_dates"
msgid "Availability check: peak-season dates"
msgstr "Verificare disponibilitate: date de sezon"

msgctxt "SettingsTooltips::eurosite::availability_season_dates"
msgid "Extra check-in dates, comma separated. 07-15 repeats every year; 2027-07-15 is checked once. They keep summer hotels published all year."
msgstr "Date de check-in suplimentare, separate prin virgulă. 07-15 se repetă anual; 2027-07-15 se verifică o singură dată. Păstrează hotelurile de vară publicate tot anul."

msgctxt "SettingsOptions::eurosite::availability_nights"
msgid "Availability check: nights"
msgstr "Verificare disponibilitate: nopți"

msgctxt "SettingsTooltips::eurosite::availability_nights"
msgid "Stay length checked (double room, 2 adults). The price shown and put on the product is for this stay."
msgstr "Durata sejurului verificat (cameră dublă, 2 adulți). Prețul afișat și pus pe produs este pentru acest sejur."

msgctxt "SettingsOptions::eurosite::hide_unavailable_products"
msgid "Hide a product when none of the checked dates has an Immediate offer"
msgstr "Ascunde produsul când nicio dată verificată nu are ofertă Imediată"

msgctxt "SettingsTooltips::eurosite::hide_unavailable_products"
msgid "Shown again when an Immediate offer returns. Products you changed by hand are never hidden or shown automatically."
msgstr "Reafișat când revine o ofertă Imediată. Produsele modificate manual nu sunt niciodată ascunse sau afișate automat."

