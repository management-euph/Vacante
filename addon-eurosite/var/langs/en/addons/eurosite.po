msgstr "Root category under which hotel products are created. Country and destination sub-categories are generated automatically."

msgctxt "SettingsOptions::eurosite::products_without_images"
msgid "Create products for hotels without images"
msgstr "Create products for hotels without images"

msgctxt "SettingsTooltips::eurosite::products_without_images"
