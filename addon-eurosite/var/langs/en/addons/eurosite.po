msgid "API password"
msgstr "API password"

msgctxt "SettingsTooltips::eurosite::api_password"
msgid "Credentials are embedded in every request's AuditInfo. Without a valid account the service answers every request with error -1000 (\"You are not authorised to access this server!\")."
msgstr "Credentials are embedded in every request's AuditInfo. Without a valid account the service answers every request with error -1000 (\"You are not authorised to access this server!\")."

msgctxt "SettingsOptions::eurosite::tourop_code"
msgid "Tour operator code"
msgstr "Tour operator code"

msgctxt "SettingsTooltips::eurosite::tourop_code"
msgid "The operator code embedded in search/booking payloads. Ask Eurosite which code your account uses — own-hotels data on the Laguna platform reports \"LA\"."
msgstr "The operator code embedded in search/booking payloads. Ask Eurosite which code your account uses — own-hotels data on the Laguna platform reports \"LA\"."

msgctxt "SettingsOptions::eurosite::default_currency"
msgid "Default currency"
msgstr "Default currency"

msgctxt "SettingsOptions::eurosite::default_language"
msgid "Default API language"
msgstr "Default API language"

msgctxt "SettingsOptions::eurosite::allow_insecure_api"
msgid "Allow plain-HTTP (unencrypted) API URL"
msgstr "Allow plain-HTTP (unencrypted) API URL"

msgctxt "SettingsTooltips::eurosite::allow_insecure_api"
msgid "Accept an API URL that starts with http://. The API username and password are then sent unencrypted; leave this off in production. An https:// URL always has its TLS certificate verified, whatever this setting says, and a URL without a scheme is treated as https://."
msgstr "Accept an API URL that starts with http://. The API username and password are then sent unencrypted; leave this off in production. An https:// URL always has its TLS certificate verified, whatever this setting says, and a URL without a scheme is treated as https://."

msgctxt "SettingsOptions::eurosite::payment_terms_text"
msgid "Payment terms text"
msgstr "Payment terms text"

msgctxt "SettingsTooltips::eurosite::payment_terms_text"
msgid "Shown in the \"Cancellation and payment terms\" window, one line per line: the Eurosite API gives no payment schedule before booking, so the store writes these lines."
msgstr "Shown in the \"Cancellation and payment terms\" window, one line per line: the Eurosite API gives no payment schedule before booking, so the store writes these lines."

