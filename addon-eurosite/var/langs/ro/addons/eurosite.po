msgctxt "Languages::eurosite.hotels_need_whitelist"
msgid "Nothing to fetch: no destinations are whitelisted."
msgstr "Nu are ce prelua: nicio destinație nu este în listă."

msgctxt "Languages::eurosite.open_whitelist"
