msgctxt "Languages::eurosite.on_request_note"
msgid "Disponibilitate la cerere — rezervarea se confirmă ulterior."
msgstr "Disponibilitate la cerere — rezervarea se confirmă ulterior."

msgctxt "Languages::eurosite.guests_invalid"
msgid "Please fill in every guest (children need a date of birth)."
msgstr "Completați datele fiecărui turist (copiii au nevoie de data nașterii)."

msgctxt "Languages::eurosite.contact_invalid"
msgid "Please provide a valid e-mail address and phone number."
msgstr "Introduceți o adresă de e-mail validă și un număr de telefon."

msgctxt "Languages::eurosite.hotel_not_bookable"
msgid "This hotel cannot be booked online yet — please contact us to book it."
msgstr "Acest hotel nu poate fi rezervat online încă — contactați-ne pentru a-l rezerva."

msgctxt "Languages::eurosite.cart_line_dropped"
msgid "This stay could not be added to the cart — please try again or contact us."
msgstr "Acest sejur nu a putut fi adăugat în coș — încercați din nou sau contactați-ne."

msgctxt "Languages::eurosite.added_to_cart"
msgid "Your stay was added to the cart — complete checkout to confirm the reservation."
msgstr "Sejurul a fost adăugat în coș — finalizați comanda pentru a confirma rezervarea."

msgctxt "Languages::eurosite.whitelist_names_missing"
msgid "The country catalog has codes but no names. Run the 'countries' sync to refill it."
msgstr "Catalogul de țări are coduri, dar nu și denumiri. Rulați sincronizarea „countries” pentru a-l reface."

msgctxt "Languages::eurosite.sync_countries"
msgid "Sync countries"
msgstr "Sincronizează țările"

msgctxt "Languages::eurosite.last_synced"
