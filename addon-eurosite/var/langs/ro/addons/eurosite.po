msgstr "Deschide lista de destinații"

msgctxt "Languages::eurosite.jobs_stage_catalogs"
msgid "Catalogs"
msgstr "Cataloage"

msgctxt "Languages::eurosite.jobs_stage_hotels"
msgid "Hotel details and availability"
msgstr "Detaliile hotelurilor și disponibilitatea"

msgctxt "Languages::eurosite.jobs_stage_products"
msgid "Products"
msgstr "Produse"

msgctxt "Languages::eurosite.jobs_stage_upkeep"
msgid "Bookings and clean-up"
msgstr "Rezervări și curățenie"

msgctxt "Languages::eurosite.jobs_job_full"
msgid "All catalogs, each when due"
msgstr "Toate cataloagele, fiecare când îi vine rândul"

msgctxt "Languages::eurosite.jobs_job_full_desc"
msgid "Runs the six catalogs below in order, each only when it is due: the monthly ones on the 1st, the hotels once a week. One nightly line instead of six."
msgstr "Rulează în ordine cele șase cataloage de mai jos, fiecare doar când îi vine rândul: cele lunare pe 1, hotelurile o dată pe săptămână. O singură linie pe noapte în loc de șase."

msgctxt "Languages::eurosite.jobs_job_countries"
msgid "Countries"
msgstr "Țări"

msgctxt "Languages::eurosite.jobs_job_countries_desc"
msgid "The countries Eurosite offers."
msgstr "Țările oferite de Eurosite."

msgctxt "Languages::eurosite.jobs_job_own_cities"
msgid "Cities with own offers"
msgstr "Orașe cu oferte proprii"

msgctxt "Languages::eurosite.jobs_job_own_cities_desc"
msgid "The cities with the operator's own offers. Runs before Cities, so their countries get their cities even before anything is whitelisted."
msgstr "Orașele cu ofertele proprii ale operatorului. Rulează înaintea Orașelor, ca țările lor să-și primească orașele chiar înainte să fie ceva în lista de destinații."

msgctxt "Languages::eurosite.jobs_job_cities"
msgid "Cities"
msgstr "Orașe"

msgctxt "Languages::eurosite.jobs_job_cities_desc"
msgid "The cities of the countries you sell, and of those with own offers."
msgstr "Orașele țărilor pe care le vinzi și ale celor cu oferte proprii."

msgctxt "Languages::eurosite.jobs_job_hotels"
msgid "Hotels"
msgstr "Hoteluri"

msgctxt "Languages::eurosite.jobs_job_hotels_desc"
msgid "The operator's hotels and their rooms, in the whitelisted destinations."
msgstr "Hotelurile operatorului și camerele lor, din destinațiile din listă."

msgctxt "Languages::eurosite.jobs_job_room_types"
msgid "Room types"
msgstr "Tipuri de cameră"

msgctxt "Languages::eurosite.jobs_job_room_types_desc"
msgid "The catalog of room types."
msgstr "Catalogul tipurilor de cameră."

msgctxt "Languages::eurosite.jobs_job_tags"
msgid "Offer tags"
msgstr "Etichete de ofertă"

msgctxt "Languages::eurosite.jobs_job_tags_desc"
msgid "The catalog of offer tags. It may be empty."
msgstr "Catalogul etichetelor de ofertă. Poate fi gol."

msgctxt "Languages::eurosite.jobs_job_product_info"
msgid "Hotel details"
msgstr "Detaliile hotelurilor"

msgctxt "Languages::eurosite.jobs_job_product_info_desc"
msgid "Each synced hotel's details from Eurosite, kept for 30 days: a run fetches the missing and older ones, up to the \"Hotel details per night\" setting."
msgstr "Detaliile fiecărui hotel sincronizat, de la Eurosite, păstrate 30 de zile: o rulare le aduce pe cele lipsă și pe cele mai vechi, până la limita din setarea „Detalii hoteluri pe noapte”."

msgctxt "Languages::eurosite.jobs_job_availability"
msgid "Availability"
msgstr "Disponibilitate"

msgctxt "Languages::eurosite.jobs_job_availability_desc"
msgid "Which hotels in the whitelisted destinations have an Immediate offer, on the near and the peak-season dates. Hides the products of the others and shows them again when they have one."
msgstr "Ce hoteluri din destinațiile din listă au ofertă Imediat, la datele apropiate și în sezonul de vârf. Ascunde produsele celorlalte și le arată din nou când au una."

msgctxt "Languages::eurosite.jobs_job_add_products"
msgid "Add products"
msgstr "Adaugă produse"

msgctxt "Languages::eurosite.jobs_job_add_products_desc"
msgid "A product for each hotel with an Immediate offer and pictures, in the whitelisted destinations."
msgstr "Un produs pentru fiecare hotel cu ofertă Imediat și poze, din destinațiile din listă."

msgctxt "Languages::eurosite.jobs_job_update_products"
msgid "Update products"
msgstr "Actualizează produsele"

msgctxt "Languages::eurosite.jobs_job_update_products_desc"
msgid "Brings the Eurosite products up to date: price, description, pictures and features."
msgstr "Aduce la zi produsele Eurosite: prețul, descrierea, pozele și caracteristicile."

msgctxt "Languages::eurosite.jobs_job_booking_status"
msgid "Booking confirmations"
msgstr "Confirmările rezervărilor"

msgctxt "Languages::eurosite.jobs_job_booking_status_desc"
msgid "Checks the bookings waiting for Eurosite's confirmation, on their schedule: 30 minutes after booking, then every 30 minutes for 2 hours, and again 8 hours later."
msgstr "Verifică rezervările care așteaptă confirmarea Eurosite, după programul lor: la 30 de minute după rezervare, apoi la fiecare 30 de minute timp de 2 ore și din nou după 8 ore."

msgctxt "Languages::eurosite.jobs_job_cleanup"
msgid "Clean-up"
msgstr "Curățenie"

msgctxt "Languages::eurosite.jobs_job_cleanup_desc"
msgid "Trims the sync log and removes the details of hotels that no longer exist."
msgstr "Scurtează jurnalul sincronizărilor și șterge detaliile hotelurilor care nu mai există."

msgctxt "Languages::eurosite.jobs_full_force"
msgid "Run every catalog now"
msgstr "Rulează acum toate cataloagele"

msgctxt "Languages::eurosite.jobs_full_force_confirm"
msgid "Run every catalog now, also the ones not due yet? It makes many API calls."
msgstr "Rulezi acum toate cataloagele, și pe cele care nu sunt încă la rând? Face multe apeluri API."

msgctxt "Languages::eurosite.jobs_on_demand_intro"
msgid "Jobs that are not on the schedule: run them from here when needed."
msgstr "Joburi care nu sunt în program: rulează-le de aici când e nevoie."

msgctxt "Languages::eurosite.jobs_unknown"
msgid "Unknown job: [job]"
msgstr "Job necunoscut: [job]"

msgctxt "Languages::eurosite.jobs_plan_full"
msgid "Catalogs in one nightly run (recommended)"
msgstr "Cataloagele într-o singură rulare pe noapte (recomandat)"

msgctxt "Languages::eurosite.jobs_plan_full_hint"
msgid "One line at 01:00 runs the catalogs, each only when it is due; the other jobs keep their own lines. Install one plan only: both would run every catalog twice."
msgstr "O linie la 01:00 rulează cataloagele, fiecare doar când îi vine rândul; celelalte joburi își păstrează liniile lor. Instalează un singur plan: amândouă ar rula fiecare catalog de două ori."

msgctxt "Languages::eurosite.jobs_plan_per"
msgid "Each catalog on its own line"
msgstr "Fiecare catalog pe linia lui"

msgctxt "Languages::eurosite.jobs_plan_per_hint"
msgid "Each catalog at its own time, to move one of them elsewhere. Install one plan only: both would run every catalog twice."
msgstr "Fiecare catalog la ora lui, ca să poți muta unul dintre ele. Instalează un singur plan: amândouă ar rula fiecare catalog de două ori."

